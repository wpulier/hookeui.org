    "questions": [
      {
        "q": "How many of these cells are dividing?",
        "use": {
          "cellpose-sam": "find every cell",
          "spot-measure": "measure each one",
          "bioclip-2": "group look-alikes",
          "fiji": "count them",
          "gemini-3.8-flash": "which look like they divide"
        }
      },
      {
        "q": "Follow every swimmer for the next hour.",
        "use": {
          "edgetam": "follow each one",
          "trackastra": "link them over time",
          "cellpose-sam": "outline every frame",
          "spot-measure": "speed of every track",
          "claude-opus-5-5": "explain the spread"
        }
      },
      {
        "q": "What changed since yesterday’s slide?",
        "use": {
          "dinov3-small": "describe both slides",
          "sam3.1-cloud": "outline the regions",
          "micro-sam-lm": "refine the edges",
          "fiji": "measure both",
          "gpt-6.1-sol": "say what changed, and why"
        }
      }
    ]
  }
